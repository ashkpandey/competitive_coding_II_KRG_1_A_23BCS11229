#include <bits/stdc++.h>
using namespace std;

long long computeHash(string s) {
    const int p = 31;
    const int mod = 1e9 + 7;

    long long hash = 0;
    long long power = 1;

    for (char c : s) 
    {
    hash = (hash + (c - 'a' + 1) * power) % mod;
    power = (power * p) % mod;
    }

    return hash;
}

int main() {
    string s;
    cin >> s;

    cout << computeHash(s) << endl;
}
